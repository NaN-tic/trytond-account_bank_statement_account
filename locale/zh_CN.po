#, python-format
msgctxt "model:ir.message,text:account_statement_line_currency"
msgid ""
"The Bank Statement Journal \"%(journal)s\" has a different second currency "
"of the account \"%(account)s\". And that's not allowed."
msgstr "银行对账单日记账“%(journal)s”的第二货币与科目“%(account)s”的第二货币不同，不允许此操作。"
