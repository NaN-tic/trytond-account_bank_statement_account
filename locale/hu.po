#, python-format
msgctxt "model:ir.message,text:account_not_bank_reconcile"
msgid ""
"The of Bank Statement Journal \"%(journal)s\" is not checked as \"Bank "
"Conciliation\"."
msgstr ""
"A(z) „%(journal)s” bankkivonatnaplónál nincs bejelölve a „Banki egyeztetés”."

#, python-format
msgctxt "model:ir.message,text:account_statement_journal"
msgid ""
"Please provide debit and credit account on statement journal "
"\"%(journal)s\"."
msgstr ""
"Adja meg a tartozik és követel számlát a(z) „%(journal)s” kivonatnaplónál."

#, python-format
msgctxt "model:ir.message,text:amount_greater_invoice_amount_to_pay"
msgid "Amount \"%(amount)s\" is greater than the amount to pay of invoice."
msgstr "A(z) „%(amount)s” összeg meghaladja a számla fizetendő összegét."

#, python-format
msgctxt "model:ir.message,text:invoice_in_statement_move_line"
msgid ""
"Invoice \"%(invoice)s\" cannot be moved to \"Draft\" state because it is "
"already used in statement line \"%(statement_line)s\"."
msgstr ""
"A(z) „%(invoice)s” számla nem állítható vissza piszkozatra, mert már "
"használatban van a(z) „%(statement_line)s” kivonatsorban."

#, python-format
msgctxt "model:ir.message,text:same_account"
msgid ""
"Account \"%(account)s\" in statement line \"%(line)s\" is the same as the "
"one configured on journal \"%(journal)s\"."
msgstr ""
"A(z) „%(line)s” kivonatsor „%(account)s” számlája megegyezik a(z) "
"„%(journal)s” naplóban beállított számlával."

msgctxt "view:account.bank.statement.move.line:"
msgid "Statement Line Move Line"
msgstr "Kivonatsor könyvelési sora"

msgctxt "view:account.bank.statement.move.line:"
msgid "Statement Lines"
msgstr "Számlakivonat sorok"

msgctxt "field:account.bank.statement.move.line,currency:"
msgid "Currency"
msgstr "Pénznem"

#, python-format
msgctxt "model:ir.message,text:account_statement_line_currency"
msgid ""
"The Bank Statement Journal \"%(journal)s\" has a different second currency "
"of the account \"%(account)s\". And that's not allowed."
msgstr ""
"A(z) „%(journal)s” bankkivonatnapló második pénzneme eltér a(z) "
"„%(account)s” számla második pénznemétől. Ez nem megengedett."
